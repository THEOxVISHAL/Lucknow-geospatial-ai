 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Lucknow Land Cover - Data Preparation\n",
    "\n",
    "This notebook:\n",
    "1. Reads 4 Sentinel-2 L2A SAFE folders\n",
    "2. Computes 7 spectral indices per date\n",
    "3. Stacks into 17-band multi-temporal composite\n",
    "4. Fetches Dynamic World labels via Google Earth Engine\n",
    "5. Saves outputs for chip creation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.append('../')\n",
    "\n",
    "import numpy as np\n",
    "import rasterio\n",
    "from rasterio.windows import Window\n",
    "from rasterio.enums import Resampling\n",
    "import geopandas as gpd\n",
    "from pathlib import Path\n",
    "import yaml\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "from src.preprocessing.compute_indices import compute_indices, stack_composite\n",
    "\n",
    "# Load config\n",
    "with open('../config.yaml') as f:\n",
    "    config = yaml.safe_load(f)\n",
    "\n",
    "AOI_PATH = Path(config['project']['aoi_path'])\n",
    "RAW_DIR = Path('data/raw')\n",
    "PROCESSED_DIR = Path('data/processed')\n",
    "LABELS_DIR = Path('data/labels')\n",
    "PROCESSED_DIR.mkdir(parents=True, exist_ok=True)\n",
    "LABELS_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "DATES = config['project']['dates']\n",
    "BANDS = config['data']['bands']  # [2,3,4,5,6,7,8,8a,11,12]\n",
    "print('AOI:', AOI_PATH)\n",
    "print('Dates:', DATES)\n",
    "print('Bands:', BANDS)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Find SAFE folders for each date\n",
    "safe_folders = {}\n",
    "for d in DATES:\n",
    "    date_str = d.replace('-', '')\n",
    "    matches = list(RAW_DIR.glob(f'*{date_str}*/'))\n",
    "    if not matches:\n",
    "        matches = list(RAW_DIR.glob(f'*{date_str[:6]}*/'))\n",
    "    if not matches:\n",
    "        # Try any S2 folder\n",
    "        matches = list(RAW_DIR.glob('S2*/'))\n",
    "    if matches:\n",
    "        safe_folders[d] = matches[0]\n",
    "        print(f'{d}: {matches[0].name}')\n",
    "    else:\n",
    "        print(f'{d}: NOT FOUND')\n",
    "\n",
    "if len(safe_folders) != 4:\n",
    "    print('WARNING: Expected 4 dates, found', len(safe_folders))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def read_s2_bands(safe_path, bands, target_res=10):\n",
    \"\"\"\n",
    "Read Sentinel-2 L2A bands from SAFE folder.\n",
    "Upsamples 20m bands to 10m.\n",
    "\"\"\"\n",
    "safe_path = Path(safe_path)\n",
    "\n",
    "# Band resolution mapping\n",
    "band_res = {\n",
    "    2: 10, 3: 10, 4: 10, 8: 10,  # 10m\n",
    "    5: 20, 6: 20, 7: 20, 8: 20, 11: 20, 12: 20  # 20m (B8A=8)\n",
    "}\n",
    "\n",
    "# Find GRANULE directory\n",
    "granule_dirs = list(safe_path.glob('GRANULE/*/IMG_DATA'))\n",
    "if not granule_dirs:\n",
    "    raise FileNotFoundError(f'No GRANULE/IMG_DATA in {safe_path}')\n",
    "img_data = granule_dirs[0]\n",
    "\n",
    "band_arrays = {}\n",
    "reference_shape = None\n",
    "reference_transform = None\n",
    "reference_crs = None\n",
    "\n",
    "for b in bands:\n",
    "    res = band_res.get(b, 10)\n",
    "    res_dir = f'R{res}m'\n",
    "    band_name = f'B{b:02d}' if b != 8 else 'B08'\n",
    "    if b == 8:\n",
    "        band_name = 'B08'  # 10m NIR\n",
    "    elif b == 8 and '8a' in str(b):\n",
    "        band_name = 'B8A'\n",
    "    \n",
    "    # Find the .jp2 file\n",
    "    pattern = f'*{band_name}*.jp2'\n",
    "    files = list(img_data.glob(f'{res_dir}/{pattern}'))\n",
    "    if not files:\n",
    "        # Try alternate naming\n",
    "        files = list(img_data.rglob(f'*{band_name}*.jp2'))\n",
    "    if not files:\n",
    "        raise FileNotFoundError(f'Band {band_name} not found in {img_data}')\n",
    "    \n    "    with rasterio.open(files[0]) as src:\n",
    "        arr = src.read(1).astype(np.float32) / 10000.0  # L2A scaling\n",
    "        \n",
    "        if res == 20:\n",
    "            # Upsample to 10m\n",
    "            from rasterio.warp import reproject\n",
    "            upsampled = np.empty((arr.shape[0]*2, arr.shape[1]*2), dtype=np.float32)\n",
    "            reproject(\n",
    "                source=arr,\n",
    "                destination=upsampled,\n",
    "                src_transform=src.transform,\n",
    "                src_crs=src.crs,\n",
    "                dst_transform=src.transform * src.transform.scale(0.5, 0.5),\n",
    "                dst_crs=src.crs,\n",
    "                resampling=Resampling.bilinear\n",
    "            )\n",
    "            arr = upsampled\n",
    "            transform = src.transform * src.transform.scale(0.5, 0.5)\n",
    "        else:\n",
    "            transform = src.transform\n",
    "        \n",
    "        if reference_shape is None:\n",
    "            reference_shape = arr.shape\n",
    "            reference_transform = transform\n",
    "            reference_crs = src.crs\n",
    "        \n",
    "        band_arrays[b] = arr\n",
    "\n",
    "# Stack bands in order\n",
    "stacked = np.stack([band_arrays[b] for b in bands], axis=-1)  # (H, W, C)\n",
    "\n",
    "return stacked, reference_transform, reference_crs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Read all 4 dates\n",
    "date_composites = []\n",
    "\n",
    "for date_str, safe_folder in safe_folders.items():\n",
    "    print(f'Reading {date_str} from {safe_folder.name}...')\n",
    "    bands, transform, crs = read_s2_bands(safe_folder, BANDS)\n",
    "    indices = compute_indices(bands)\n",
    "    date_composites.append({'bands': bands, 'indices': indices})\n",
    "    print(f'  Bands shape: {bands.shape}, Indices: {list(indices.keys())}')\n",
    "\n",
    "# Stack multi-temporal composite (median across dates)\n",
    "composite = stack_composite(date_composites)\n",
    "print(f'Final composite shape: {composite.shape}')  # Should be (H, W, 17)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save 17-band composite\n",
    "output_path = PROCESSED_DIR / 'lucknow_composite_17band.tif'\n",
    "\n",
    "with rasterio.open(\n",
    "    output_path, 'w',\n",
    "    driver='GTiff',\n",
    "    height=composite.shape[0],\n",
    "    width=composite.shape[1],\n",
    "    count=composite.shape[2],\n",
    "    dtype='float32',\n",
    "    crs=crs,\n",
    "    transform=reference_transform,\n",
    "    compress='lzw',\n",
    "    tiled=True,\n",
    "    blockxsize=256,\n",
    "    blockysize=256\n",
    ") as dst:\n",
    "    for i in range(composite.shape[2]):\n",
    "        dst.write(composite[:,:,i], i+1)\n",
    "    # Band descriptions\n",
    "    band_names = [f'B{b}' for b in BANDS] + ['NDVI','NDWI','NDBI','BSI','SAVI','EVI','NBR']\n",
    "    dst.descriptions = tuple(band_names)\n",
    "\n",
    "print(f'Saved composite to {output_path}')\n",
    "print(f'Bands: {band_names}')"
   ]
  },
