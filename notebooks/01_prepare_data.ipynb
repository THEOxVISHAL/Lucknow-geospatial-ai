  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Optional: Manual QGIS Corrections\n",
    "\n",
    "1. Open `lucknow_composite_17band.tif` (render RGB: B4,B3,B2) + `dw_labels.tif` in QGIS\n",
    "2. Create new GeoPackage: `manual_corrections.gpkg` with polygon layer\n",
    "3. Add field `class_id` (integer 0-5)\n",
    "4. Digitize ~30 correction polygons:\n",
    "   - 10: Dense Forest (class 0) in Kukrail core\n",
    "   - 10: Agriculture vs Bare separation (class 2 vs 5)\n",
    "   - 10: Urban fringe (class 3) vs Bare\n",
    "5. Run merge script below"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Merge DW labels with manual corrections\n",
    "# Run after creating manual_corrections.gpkg in QGIS\n",
    "\n",
    "import rasterio\n",
    "import geopandas as gpd\n",
    "from rasterio.features import rasterize\n",
    "import numpy as np\n",
    "\n",
    "dw_path = Path('../data/labels/dw_labels.tif')\n",
    "corr_path = Path('../data/labels/manual_corrections.gpkg')\n",
    "out_path = Path('../data/labels/lucknow_labels.tif')\n",
    "\n",
    "if dw_path.exists() and corr_path.exists():\n",
    "    with rasterio.open(dw_path) as src:\n",
    "        dw = src.read(1)\n",
    "        profile = src.profile\n",
    "        transform = src.transform\n",
    "        crs = src.crs\n",
    "    \n",
    "    corrections = gpd.read_file(corr_path).to_crs(crs)\n",
    "    \n",
    "    # Rasterize corrections\n",
    "    shapes = [(geom, val) for geom, val in zip(corrections.geometry, corrections.class_id)]\n",
    "    correction_raster = rasterize(\n",
    "        shapes,\n",
    "        out_shape=dw.shape,\n",
    "        transform=transform,\n",
    "        fill=255,\n",
    "        dtype=np.uint8\n",
    "    )\n",
    "    \n",
    "    # Merge: corrections override DW\n",
    "    final_labels = dw.copy()\n",
    "    mask = correction_raster != 255\n",
    "    final_labels[mask] = correction_raster[mask]\n",
    "    \n",
    "    profile.update(dtype='uint8', compress='lzw', count=1)\n",
    "    with rasterio.open(out_path, 'w', **profile) as dst:\n",
    "        dst.write(final_labels, 1)\n",
    "    \n",
    "    print(f'Merged labels saved to {out_path}')\n",
    "    print(f'Classes: {np.unique(final_labels)}')\n",
    "else:\n",
    "    print('Waiting for DW labels and/or manual corrections...')\n",
    "    if dw_path.exists():\n",
    "        import shutil\n",
    "        shutil.copy(dw_path, out_path)\n",
    "        print('Using DW labels as-is')"
   ]
